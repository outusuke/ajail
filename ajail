# ======== 10_util: Utilities: logging, notifications, name cleaning, install hints.

def distro_family():
    ids = []
    try:
        for ln in open(OS_RELEASE):
            k, _, v = ln.strip().partition("=")
            if k in ("ID", "ID_LIKE"): ids += v.strip('"').lower().split()
    except OSError:
        return None
    for fam, keys in (("fedora", ("fedora", "rhel")), ("debian", ("debian", "ubuntu")),
                      ("arch", ("arch",))):
        if any(k in ids for k in keys): return fam
    return None

def install_hint(*pkgs):
    """'sudo dnf install foo' style hint for this distro, or a generic one if it isn't recognised."""
    fam = distro_family()
    if fam not in INSTALL_CMD: return "install " + ", ".join(pkgs) + " with your package manager"
    return f"{INSTALL_CMD[fam]} " + " ".join(pkgs)

# Control characters (C0 except tab/newline, DEL and C1) are stripped from app output before it reaches a terminal or the log.
CTRL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")

def die(msg, code=1):
    print(f"ajail: {msg}", file=sys.stderr); sys.exit(code)

def split_opts(args, allowed, usage):
    """Split a command's arguments into (set of options, other arguments). An option (anything starting with '--') that
    is not in ALLOWED is an error, so a typo like --trsh or --purg is never silently ignored."""
    opts, rest = set(), []
    for x in args:
        if x.startswith("--"):
            if x not in allowed: die(f"unknown option '{x[:40]}'\n{usage}")
            opts.add(x)
        else: rest.append(x)
    return opts, rest

def log(msg, name=None):
    try:
        os.makedirs(STATE, exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > 1_000_000:
            tail = open(LOG, errors="replace").readlines()[-500:]
            open(LOG, "w").writelines(tail)
        with open(LOG, "a") as f:
            f.write(f"[{time.strftime('%F %T')}] " + (f"[{name}] " if name else "") + f"{msg}\n")
    except OSError:
        pass

LOG_RUN_MAX = 2_000_000    # bytes of one app run's output kept in the log
LOG_LINE_MAX = 65_536     # longest log line: longer output is split, so one unbroken stream can't pile up in memory
NO_LOG = [False]      # set by 'preview' so that showing a command never writes to the log

def warn(msg, name=None):
    """A warning for the terminal and the log, so it also shows up on ajail-gui's Log page (menu launches have no terminal)."""
    print(f"ajail: {msg}", file=sys.stderr)
    if not NO_LOG[0]: log(f"WARNING {msg}", name)

def notify(msg, critical=False):
    if shutil.which("notify-send"):
        try:
            subprocess.run(["notify-send", "-u", "critical" if critical else "normal", "ajail", msg],
                           timeout=5, check=False)
        except Exception:
            pass

_act = []
def notify_failure(name):
    """Critical notification; clicking it (or its 'Open log' button) opens ajail-gui on this app's log."""
    msg = f"{name} failed to start. Click to open the log."
    if not shutil.which("notify-send"): return
    if not _act:
        try: _act.append("--action" in subprocess.run(["notify-send", "--help"], capture_output=True, text=True).stdout)
        except Exception: _act.append(False)
    if not _act[0]:
        notify(f"{name} failed to start. Open ajail-gui > Log.", critical=True); return
    try:
        if os.fork(): return                      # parent carries on and exits
    except OSError:
        return
    try:                                          # child waits for the click, detached from the terminal
        os.setsid()
        dn = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2): os.dup2(dn, fd)
        r = subprocess.run(["notify-send", "-u", "critical", "-A", "default=Open log", "--wait", "ajail", msg],
                           capture_output=True, text=True, timeout=900)
        if r.stdout.strip() == "default":
            subprocess.Popen([f"{os.path.dirname(SELF)}/ajail-gui", "--log", name], start_new_session=True)
    except Exception:
        pass
    finally:
        os._exit(0)

def clean(n):
    return (re.sub(r"[^A-Za-z0-9._-]", "_", n).lstrip("._-")[:64]) or "app"

def sanitize(path):
    n = re.sub(r"\.appimage$", "", os.path.basename(path), flags=re.I)
    s = re.sub(r"[-_](?:v?\d[\w.+~]*|x86[-_]64|amd64|x64|aarch64|arm64|linux\w*)(?=[-_]|$)", "", n, flags=re.I)
    return clean(s or n)


# ======== 20_core: SECURITY CORE: everything that decides what the sandbox can touch. Read this file line by line.

def safe_path(p):
    """A file or folder an app may be given: non-hidden inside $HOME, or on a mounted drive."""
    try:
        p = os.path.realpath(p)
    except Exception:
        return None
    if "\n" in p or not os.path.exists(p):
        return None
    if p.startswith(HOME + "/"):
        return None if p[len(HOME) + 1:].split("/")[0].startswith(".") else p
    return p if any(p.startswith(b) for b in OUTSIDE) else None

def xdg_dir(kind):
    path = None
    try:
        for ln in open(f"{HOME}/.config/user-dirs.dirs"):
            m = re.match(rf'XDG_{kind.upper()}_DIR="(.*)"', ln.strip())
            if m: path = m.group(1).replace("$HOME", HOME)
    except OSError:
        pass
    return path or f"{HOME}/{XDG_DEFAULT[kind]}"

def empty_cfg():
    return {"s": {}, **{k: [] for k in LISTS}}

COMMENT = re.compile(r"(^|\s)#.*$")     # '#' starts a comment at the start of a line or after whitespace
TALK_RE = re.compile(r"[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z0-9_-]+)*(\.\*)?")     # no empty parts: "org..x" is not a name

def talk_ok(n):
    """A D-Bus name for talk=: a plain name, or NAME.* with at least three parts before the .* . So 'org.*' and
    'org.freedesktop.*' (which would reach secrets, systemd and more) are refused; 'org.example.App.*' is fine."""
    return bool(TALK_RE.fullmatch(n)) and (not n.endswith(".*") or n.count(".") >= 3)

def parse_cfg(path):
    """Read one settings file. Whitespace around keys and values is ignored, and '#' starts a comment (so
    'net = 0  # no network' works). A line that can't be used is skipped with a warning (terminal and log),
    never silently, so a typo can't leave an app with more access than you meant."""
    try:
        with open(path) as f: lines = f.read().splitlines()
    except OSError:
        return None
    d = empty_cfg()
    for no, raw in enumerate(lines, 1):
        ln = COMMENT.sub("", raw).strip()
        if not ln: continue
        def bad(why):
            warn(f"{path}:{no}: ignoring '{ln[:60]}': {why}")
        if "=" not in ln:
            bad("expected key=value"); continue
        k, _, v = (x.strip() for x in ln.partition("="))
        if k == "portal":
            # "portal=NAME" turns a portal on; "portal=-NAME" (in an app's file) turns off one the defaults turned on
            if v and v.lstrip("-") in EXTRA_PORTALS and v.count("-") <= 1: d[k].append(v)
            else: bad(f"unknown portal '{v}'")
        elif k in LISTS:
            if not v: bad("empty value")
            elif k == "talk" and not talk_ok(v): bad("not a usable D-Bus name (a wildcard needs three parts first, like org.example.App.*)")
            else: d[k].append(v)
        elif k in DEFAULTS:
            if v in ("0", "1"): d["s"][k] = int(v)
            else: bad("expected 0 or 1")
        elif k in NUM:
            if v.isdigit(): d["s"][k] = min(int(v), 10**7)
            else: bad("expected a whole number")
        elif k == "profile":
            if v == "strict": d["s"].update(net=0, sound=0)
            else: bad("only 'strict' is known")
        elif k == "flag":
            if v in LEGACY_FLAGS: d["s"][LEGACY_FLAGS[v][0]] = LEGACY_FLAGS[v][1]
            else: bad("unknown flag")
        else:
            bad("unknown setting")
    return d

def load_cfg(name):
    """Built-in defaults < default.conf < apps/NAME.conf. Lists add up, except xdg (per folder)."""
    g = parse_cfg(f"{CONF}/default.conf") or empty_cfg()
    a = parse_cfg(f"{CONF}/apps/{name}.conf") or empty_cfg()
    cfg = {**DEFAULTS, **NUM, **g["s"], **a["s"]}
    for k in ("allow", "allow_ro", "env", "talk"):
        cfg[k] = list(dict.fromkeys(g[k] + a[k]))
    on = []
    for p in g["portal"] + a["portal"]:          # in order, so an app's "-NAME" undoes the default's NAME
        if p.startswith("-"):
            if p[1:] in on: on.remove(p[1:])
        elif p not in on: on.append(p)
    cfg["portal"] = on
    xd = {}
    for x in g["xdg"] + a["xdg"]:
        k, _, m = x.partition(":"); xd[k] = m
    cfg["xdg"] = [f"{k}:{m}" if m else k for k, m in xd.items()]
    return cfg

def share_list(cfg):
    out = [("--bind", p) for p in cfg["allow"]] + [("--ro-bind", p) for p in cfg["allow_ro"]]
    for x in cfg["xdg"]:
        kind, _, mode = x.partition(":")
        if kind in XDG_DEFAULT and mode != "none":
            out.append(("--ro-bind" if mode == "ro" else "--bind", xdg_dir(kind)))
    return out

def compat_env(environ):
    """The variables 'compat_env' lets through: those of COMPAT_ENV and anything starting with a COMPAT_ENV_PREFIXES
    entry, but only if set. Names are matched exactly (case-sensitive), so 'mesa_x' or 'XMESA_X' do not qualify.
    Never anything else, whatever the value looks like."""
    return {k: v for k, v in environ.items() if k in COMPAT_ENV or k.startswith(COMPAT_ENV_PREFIXES)}

def runtime_dir():
    return os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"

def wayland_path():
    wl = os.environ.get("WAYLAND_DISPLAY", "")
    if not wl: return None
    p = wl if wl.startswith("/") else f"{runtime_dir()}/{wl}"
    return p if os.path.exists(p) else None

_has = {}
def bwrap_has(opt):
    if opt not in _has:
        try:
            r = subprocess.run(["bwrap", "--help"], capture_output=True, text=True)
            _has[opt] = opt in (r.stdout + r.stderr)
        except Exception:
            _has[opt] = False
    return _has[opt]

BASE = ["--ro-bind", "/usr", "/usr", "--symlink", "usr/lib", "/lib", "--symlink", "usr/lib64", "/lib64",
        "--symlink", "usr/bin", "/bin", "--symlink", "usr/sbin", "/sbin"]

def seccomp_file(harden=False):
    """Syscall blocklist (like Flatpak's), generated as a raw BPF program. No extra packages needed."""
    arch = {"x86_64": (0xC000003E, SYSCALLS_X86_64), "aarch64": (0xC00000B7, SYSCALLS_AARCH64)}.get(platform.machine())
    if not arch:
        return None
    audit, nrs = arch
    if harden: nrs = nrs + SYSCALLS_EXTRA[platform.machine()]
    deny = 0x00050000 | errno.EPERM
    ins = [(0x20, 0, 0, 4),                    # load arch
           (0x15, 1, 0, audit),                # native arch? skip the next instruction
           (0x06, 0, 0, deny),                 # other ABI (32-bit/x32): deny
           (0x20, 0, 0, 0)]                    # load syscall number
    n = len(nrs)
    # x32 calls share the x86_64 audit arch and only differ by bit 30 of the number: deny them all (skips the list + allow)
    ins += [(0x35, n + 1, 0, 0x40000000)]                       # number >= 0x40000000: jump to deny
    ins += [(0x15, n - i, 0, nr) for i, nr in enumerate(nrs)]   # listed syscall: jump to deny
    ins += [(0x06, 0, 0, 0x7FFF0000), (0x06, 0, 0, deny)]       # allow, deny
    try:
        tf = tempfile.TemporaryFile()
        tf.write(b"".join(struct.pack("=HBBI", *i) for i in ins)); tf.flush(); tf.seek(0)
        return tf
    except OSError as e:
        log(f"seccomp disabled: {e}")
        return None

def want_bus(cfg):
    return bool(cfg["portals"] or cfg["tray"] or cfg["talk"])

# Desktop portals an app may call when "Notifications and portals" is on. xdg-dbus-proxy runs on the host, so the
# desktop sees the app as an ordinary unsandboxed program: a portal that is not listed here is simply unreachable.
# Off unless asked for with portal=NAME (EXTRA_PORTALS): Location, GlobalShortcuts, RemoteDesktop (input injection),
# InputCapture, Wallpaper, DynamicLauncher, Secret. Never reachable: Documents and anything else not listed.
# Camera follows the Camera permission; Screenshot and ScreenCast (both show the user a prompt) have their own switches.
PORTAL_NAME = "org.freedesktop.portal.Desktop"
PORTAL_BASIC = ("Settings", "OpenURI", "FileChooser", "Notification", "Print", "Inhibit", "Background", "Account",
                "Email", "Trash", "NetworkMonitor", "ProxyResolver", "GameMode", "MemoryMonitor",
                "PowerProfileMonitor", "Realtime")

def extra_portals(cfg):
    """The opt-in portals enabled for this app: allowlisted names only, no duplicates."""
    return [p for p in dict.fromkeys(cfg["portal"]) if p in EXTRA_PORTALS]

def portal_rules(cfg):
    """xdg-dbus-proxy rules for Notifications and the allowed portals (see PORTAL_BASIC above)."""
    ifaces = list(PORTAL_BASIC)
    if cfg["camera"]: ifaces.append("Camera")
    if cfg["portal_screenshot"]: ifaces.append("Screenshot")
    if cfg["portal_screencast"]: ifaces.append("ScreenCast")
    ifaces += [p for p in extra_portals(cfg) if p not in ifaces]
    rules = ["--talk=org.freedesktop.Notifications", f"--see={PORTAL_NAME}"]
    rules += [f"--call={PORTAL_NAME}=org.freedesktop.portal.{i}.*" for i in ifaces]
    rules += [f"--call={PORTAL_NAME}=org.freedesktop.portal.Request.*@/org/freedesktop/portal/desktop/request/*",
              f"--call={PORTAL_NAME}=org.freedesktop.portal.Session.*@/org/freedesktop/portal/desktop/session/*",
              f"--call={PORTAL_NAME}=org.freedesktop.DBus.Properties.*@/org/freedesktop/portal/desktop",
              "--broadcast=org.freedesktop.portal.*=@/org/freedesktop/portal/*"]
    return rules

# Tray icons (StatusNotifierItem) own a name like org.kde.StatusNotifierItem-PID-N. xdg-dbus-proxy only takes a wildcard at
# the end after a dot ("org.kde.*"), so rather than allowing every org.kde name, the likely names are listed. The PID is the
# one inside the sandbox (it has its own PID namespace), so it is small. An app whose main process has a higher PID gets no
# tray icon: the self-test shows this, and the range can be raised here.
TRAY_PIDS = range(2, 65)
TRAY_IDS = range(1, 4)

def tray_rules():
    return ["--talk=org.kde.StatusNotifierWatcher"] + [
        f"--own=org.kde.StatusNotifierItem-{p}-{i}" for p in TRAY_PIDS for i in TRAY_IDS]

def start_bus(cfg, name):
    if not want_bus(cfg): return None
    px = shutil.which("xdg-dbus-proxy")
    if not px:
        warn("xdg-dbus-proxy missing, so notifications/portals are off. Install: " + install_hint("xdg-dbus-proxy"), name)
        return None
    addr = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or f"unix:path={runtime_dir()}/bus"
    d = f"{runtime_dir()}/ajail"
    os.makedirs(d, mode=0o700, exist_ok=True)
    sock = f"{d}/{os.getpid()}.bus"
    rules = ["--filter"]
    if cfg["portals"]:
        rules += portal_rules(cfg)
    if cfg["tray"]:
        rules += tray_rules() + ["--own=org.mpris.MediaPlayer2.*"]
    rules += [f"--talk={n}" for n in cfg["talk"] if talk_ok(n)]
    r, w = os.pipe()
    proc = subprocess.Popen([px, f"--fd={w}", addr, sock] + rules, pass_fds=[w],
                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    os.close(w)
    ok = False
    try:
        ok = bool(select.select([r], [], [], 3)[0]) and bool(os.read(r, 1))
    except OSError:
        pass
    b = (proc, r, sock)
    if not ok:
        stop_bus(b)
        print("ajail: could not start xdg-dbus-proxy; running without D-Bus", file=sys.stderr)
        log("xdg-dbus-proxy failed to start", name)
        return None
    return b

def stop_bus(b):
    if not b: return
    proc, r, sock = b
    try: os.close(r)
    except OSError: pass
    try: proc.terminate(); proc.wait(2)
    except Exception: pass
    try: os.unlink(sock)
    except OSError: pass

def private_net(cfg):
    """'Keep localhost private': the app gets its own network (via pasta) that reaches the internet but not this computer."""
    return bool(cfg["net"] and cfg["net_private"])

# pasta gives the sandbox its own network namespace. Nothing is forwarded in either direction, the gateway address is
# not mapped to this computer (--no-map-gw), and DNS goes through a forwarder address that pasta answers itself.
DNS_FWD = "169.254.1.1"
PASTA = ["pasta", "--quiet", "--config-net", "--no-map-gw", "--dns-forward", DNS_FWD,
         "-t", "none", "-u", "none", "-T", "none", "-U", "none", "--"]
SEC_FD = 9      # pasta closes inherited descriptors, so the seccomp filter is re-opened from a file inside it

def net_wrap(inner, secpath=None):
    if secpath:
        return PASTA + ["/bin/sh", "-c", f'exec {SEC_FD}<"$1"; shift; exec "$@"', "sh", secpath] + inner
    return PASTA + inner

def work_dir():
    return f"{runtime_dir()}/ajail/{os.getpid()}.d"

def machine_id(name):
    """Stable random machine-id per app (D-Bus and SDL want one; the real one would let apps fingerprint you)."""
    p = f"{CONF}/apps/{name}.machine-id"
    try:
        v = open(p).read().strip()
        if len(v) == 32: return v + "\n"
    except OSError: pass
    import uuid
    v = uuid.uuid4().hex
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        open(p, "w").write(v + "\n")
    except OSError: pass
    return v + "\n"

def make_files(cfg, d, name="app"):
    """Files bound over /etc for this run: minimal passwd/group/hosts (privacy) and a resolv.conf for private net."""
    out = {}
    os.makedirs(d, mode=0o700, exist_ok=True)
    def put(n, text):
        with open(f"{d}/{n}", "w") as f: f.write(text)
        out[n] = f"{d}/{n}"
    if cfg["privacy"]:
        gid = os.getgid()
        try: gname = grp.getgrgid(gid).gr_name
        except KeyError: gname = USER
        put("passwd", f"root:x:0:0:root:/root:/usr/sbin/nologin\n{USER}:x:{os.getuid()}:{gid}::{HOME}:"
                      f"{_pw.pw_shell or '/bin/sh'}\nnobody:x:65534:65534:Nobody:/:/usr/sbin/nologin\n")
        put("group", f"root:x:0:\n{gname}:x:{gid}:\nnogroup:x:65534:\n")
        put("hosts", "127.0.0.1 localhost\n::1 localhost\n")
    if private_net(cfg):
        put("resolv.conf", f"nameserver {DNS_FWD}\n")
    put("machine-id", machine_id(name))
    return out

def preview_files(cfg):
    d = f"{runtime_dir()}/ajail/PID.d"
    n = (["passwd", "group", "hosts"] if cfg["privacy"] else []) + (["resolv.conf"] if private_net(cfg) else []) + ["machine-id"]
    return {x: f"{d}/{x}" for x in n}

def scoped_xauth(src, disp):
    """A copy of the XAUTHORITY file holding only the cookie for DISPLAY, or None (then it is not shared at all)."""
    # Done in Python (no xauth needed, and many Wayland desktops don't install it). Entries are kept when they are
    # for this display number or have no display number (wildcard entries, as Xwayland's own auth file uses).
    d = work_dir()
    if not os.path.isdir(d):
        return None
    num = disp[1:].split(".")[0].encode()
    try:
        with open(src, "rb") as f: data = f.read(1_000_000)
    except OSError:
        return None
    keep, i = [], 0
    while i + 2 <= len(data):
        start = i
        i += 2                                    # family
        fields = []
        for _ in range(4):                        # address, display number, auth name, auth data
            if i + 2 > len(data): return None     # truncated or not an Xauthority file: not shared
            n = int.from_bytes(data[i:i+2], "big"); i += 2
            fields.append(data[i:i+n]); i += n
        if i > len(data): return None
        if fields[1] in (num, b""): keep.append(data[start:i])
    if not keep:
        return None
    dst = f"{d}/Xauthority"
    try:
        fd = os.open(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "wb") as f: f.write(b"".join(keep))
    except OSError:
        return None
    return dst

def bwrap_args(name, root, cfg, inner, bus=None, sec=None, files=(), gen=None, gset=None):
    rt = runtime_dir()
    a = ["bwrap", "--unshare-all", "--die-with-parent", "--new-session", "--clearenv"]
    if not cfg["userns"]:
        # --disable-userns needs an explicit --unshare-user ("--unshare-all" only tries one). If a user namespace can't be
        # made, the app does not start: asked for stricter isolation, it never silently gets less.
        if bwrap_has("--disable-userns"): a += ["--unshare-user", "--disable-userns"]
        else: warn("this bubblewrap is too old for --disable-userns; ignoring", name)
    if cfg["privacy"]:
        if bwrap_has("--hostname"): a += ["--hostname", "ajail"]
        else: warn("this bubblewrap is too old for --hostname; the computer name stays visible", name)
    if private_net(cfg):
        a += ["--uid", str(os.getuid()), "--gid", str(os.getgid())]     # keep your own ids inside pasta's namespace
    if cfg["net"]: a.append("--share-net")
    if sec is not None: a += ["--seccomp", str(sec)]
    a += BASE + ["--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", "/run",
                 "--dir", "/var", "--symlink", "../tmp", "/var/tmp", "--dir", "/var/lib/dbus",
                 "--symlink", "/etc/machine-id", "/var/lib/dbus/machine-id", "--perms", "0700", "--dir", rt]
    gen = gen or {}
    for p in ETC:
        if p not in gen: a += ["--ro-bind-try", f"/etc/{p}", f"/etc/{p}"]
    for n, src in gen.items():
        a += ["--ro-bind", src, f"/etc/{n}"]
    env = {"HOME": HOME, "USER": USER, "LOGNAME": USER, "PATH": "/usr/local/bin:/usr/bin:/usr/sbin",
           "XDG_RUNTIME_DIR": rt, "APPDIR": "/app", "AJAIL_ACTIVE": "1",
           "ELECTRON_OZONE_PLATFORM_HINT": "auto" if cfg["x11"] else "wayland"}
    for k in ("LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE", "LC_MESSAGES", "LC_TIME", "TZ", "TERM",
              "XDG_CURRENT_DESKTOP", "XDG_SESSION_DESKTOP", "XCURSOR_THEME", "XCURSOR_SIZE"):
        if k in os.environ: env[k] = os.environ[k]
    wp = wayland_path()
    if wp:
        a += ["--ro-bind", wp, wp]
        env["WAYLAND_DISPLAY"] = os.environ["WAYLAND_DISPLAY"]; env["XDG_SESSION_TYPE"] = "wayland"
    if cfg["x11"]:
        disp = os.environ.get("DISPLAY", "")
        if disp.startswith(":"):
            sock = f"/tmp/.X11-unix/X{disp[1:].split('.')[0]}"
            a += ["--ro-bind-try", sock, sock]; env["DISPLAY"] = disp
        xa = os.environ.get("XAUTHORITY")
        if xa and os.path.isfile(xa):
            # Only this display's cookie is shared, not every cookie in the file (those can include remote displays).
            scoped = scoped_xauth(xa, disp)
            if scoped: a += ["--ro-bind", scoped, xa]; env["XAUTHORITY"] = xa
            else: warn("could not read just this display's X cookie from XAUTHORITY; not sharing it (X11 apps may fail to connect)", name)
    if cfg["sound"]:
        for s in ("pipewire-0", "pulse/native"):
            a += ["--ro-bind-try", f"{rt}/{s}", f"{rt}/{s}"]
        env["PULSE_SERVER"] = f"unix:{rt}/pulse/native"
    if cfg["gpu"]:
        if cfg["gpu_render_only"]:     # render nodes are enough to draw; the card* nodes can also drive the display
            nodes = sorted(glob.glob("/dev/dri/renderD*"))
            if not nodes: warn("no GPU render node found, so the app gets no graphics device", name)
            for p in nodes: a += ["--dev-bind", p, p]
        else:
            a += ["--dev-bind-try", "/dev/dri", "/dev/dri"]
        for p in glob.glob("/dev/nvidia*"):
            a += ["--dev-bind", p, p]
    if cfg["camera"]:
        for p in glob.glob("/dev/video*") + glob.glob("/dev/media*"):
            a += ["--dev-bind", p, p]
    if cfg["input"]:
        a += ["--dev-bind-try", "/dev/input", "/dev/input", "--ro-bind-try", "/run/udev", "/run/udev"]
    if cfg["gpu"] or cfg["camera"] or cfg["input"]:
        a += ["--ro-bind-try", "/sys/dev/char", "/sys/dev/char"]
        for p in glob.glob("/sys/devices/pci*") or ["/sys/devices"]:
            a += ["--ro-bind", p, p]
    if cfg["printing"]:
        a += ["--ro-bind-try", "/run/cups/cups.sock", "/run/cups/cups.sock"]
        env["CUPS_SERVER"] = "/run/cups/cups.sock"
    sa = os.environ.get("SSH_AUTH_SOCK", "")
    if cfg["ssh_agent"] and sa and os.path.exists(sa):
        a += ["--ro-bind", sa, sa]; env["SSH_AUTH_SOCK"] = sa
    if bus:
        a += ["--ro-bind", bus, f"{rt}/bus"]
        env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={rt}/bus"
        if cfg["portals"]: env["AJAIL_PORTALS"] = ",".join(extra_portals(cfg))     # read by the self-test
        if cfg["tray"]: env["AJAIL_TRAY"] = f"{TRAY_PIDS[0]}-{TRAY_PIDS[-1]}"      # read by the self-test
    if cfg["app_writable"]:
        # /app stays the app's own read-only files; what the app writes goes to a private layer that survives restarts
        up, wk = f"{LAYERS}/{name}/upper", f"{LAYERS}/{name}/work"
        if not NO_LOG[0]:
            for d in (up, wk): os.makedirs(d, mode=0o700, exist_ok=True)
        a += ["--overlay-src", root, "--overlay", up, wk, "/app"]
    else:
        a += ["--ro-bind", root, "/app"]
    if cfg["tmp_home"]: a += ["--perms", "0700", "--tmpfs", HOME]      # erased when the app closes
    else: a += ["--bind", f"{HOMES}/{name}", HOME]
    if cfg["theme"]:
        for rel in THEME:
            a += ["--ro-bind-try", f"{HOME}/{rel}", f"{HOME}/{rel}"]
        if gset:     # the host's button layout and cursor, read-only (see gsettings_keyfile_text)
            a += ["--ro-bind", gset, f"{HOME}/.config/glib-2.0/settings/keyfile"]
            env["GSETTINGS_BACKEND"] = "keyfile"
    for opt, p in share_list(cfg):
        ok = safe_path(p)
        if ok: a += [opt, ok, ok]
        else: warn(f"skipping unsafe or missing path '{p}'", name)
    for f in files:
        a += ["--bind", f, f]
    if cfg["compat_env"]:     # before env= below, so an explicit env= line still wins; never replaces a variable ajail set itself
        for k, v in compat_env(os.environ).items(): env.setdefault(k, v)
    for item in cfg["env"]:
        k, _, v = item.partition("=")
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k): env[k] = v
    for k, v in env.items():
        a += ["--setenv", k, v]
    return a + ["--chdir", HOME] + inner

def forward_files(extra):
    """Files/folders passed on the command line (double-click, Open with) are shared for this run."""
    out = []
    for x in extra:
        p = urllib.parse.unquote(x[7:]) if x.startswith("file://") else x
        if p.startswith("-") or not os.path.exists(p): continue
        sp = safe_path(p)
        if sp and sp not in out: out.append(sp)
    return out

def appimage_offset(path):
    with open(path, "rb") as f:
        h = f.read(64)
        if len(h) < 64 or h[:4] != b"\x7fELF": die("not an AppImage (not an ELF file)")
        if h[8:11] == b"AI\x01": die("type 1 AppImages are not supported")
        if h[8:11] != b"AI\x02": die("not a type 2 AppImage")
        e = "<" if h[5] == 1 else ">"
        if h[4] == 2:
            shoff, = struct.unpack_from(e + "Q", h, 0x28); sz, num = struct.unpack_from(e + "HH", h, 0x3A)
        else:
            shoff, = struct.unpack_from(e + "I", h, 0x20); sz, num = struct.unpack_from(e + "HH", h, 0x2E)
        off = shoff + sz * num
        f.seek(off)
        if f.read(4) not in (b"hsqs", b"sqsh"): die("could not find the squashfs image inside this file")
    return off

def ensure_extracted(app, name, off):
    st = os.stat(app); stamp = f"{st.st_size}:{st.st_mtime_ns}"
    d = f"{EXTRACT}/{name}"
    os.makedirs(EXTRACT, mode=0o700, exist_ok=True)
    with open(f"{EXTRACT}/.{name}.lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            if open(f"{d}/stamp").read() == stamp and os.path.isdir(f"{d}/root"):
                return f"{d}/root"
        except OSError:
            pass
        if not os.path.exists(UNSQ): die("unsquashfs missing: " + install_hint("squashfs-tools"))
        print(f"ajail: preparing {name} (first run or updated)...", file=sys.stderr)
        notify(f"Preparing {name} (first run or updated)")
        shutil.rmtree(d, ignore_errors=True)
        tmp = f"{EXTRACT}/{name}.tmp{os.getpid()}"
        shutil.rmtree(tmp, ignore_errors=True); os.makedirs(tmp, mode=0o700)
        cmd = ["bwrap", "--unshare-all", "--die-with-parent", "--new-session", "--clearenv"] + BASE + \
              ["--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp",
               "--ro-bind", app, "/in.AppImage", "--bind", tmp, "/out",
               UNSQ, "-no-progress", "-no-xattrs", "-o", str(off), "-d", "/out/root", "/in.AppImage"]
        r = subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, errors="replace")
        if r.returncode != 0:
            shutil.rmtree(tmp, ignore_errors=True)
            die("extraction failed:\n" + CTRL.sub("", r.stderr[-800:]))     # file names in it come from the AppImage
        subprocess.run(["chmod", "-R", "u+rwX", f"{tmp}/root"], check=False)
        open(f"{tmp}/stamp", "w").write(stamp)
        os.replace(tmp, d)
        return f"{d}/root"

def check_identity(name, root):
    """The private home is keyed by file name. Remember what the app calls itself and refuse
    a different app that merely has the same file name (it would inherit data and permissions)."""
    ident = ""
    try:
        for f in sorted(glob.glob(f"{glob.escape(root)}/*.desktop"))[:1]:
            # Hostile content: stay inside the app, regular files only, and read a bounded amount.
            if not inside(root, f) or not os.path.isfile(f): continue
            with open(f, errors="replace") as fh: text = fh.read(65536)
            m = re.search(r"^Name=(.+)$", text, re.M)
            ident = CTRL.sub("", m.group(1)).strip() if m else ""
    except OSError:
        pass
    ident = ident[:IDENT_MAX]
    p = f"{CONF}/ids/{name}"
    try: old = open(p).read().strip()
    except OSError: old = None
    if not ident:
        # No usable name (no .desktop file, or only links and unreadable files). That must not be a way around the
        # check: an app that already has an identity only runs again if the file can still prove it is that app.
        if old is not None:
            die(f"'{name}' was first used by an app called '{old}', but this file has no readable .desktop file "
                f"to say what it is.\nIt would share that app's private data and permissions. Rename the file, or "
                f"delete {p} if it really is the same app.")
        return
    if old is None:
        os.makedirs(f"{CONF}/ids", exist_ok=True)
        open(p, "w").write(ident + "\n")
        log(f"first run, identity '{ident}'", name)
        notify(f"New app '{name}' runs with your default permissions. Adjust them in ajail-gui.")
    elif old != ident:
        die(f"'{name}' was first used by an app called '{old}', but this file calls itself '{ident}'.\n"
            f"It would share that app's private data and permissions. Rename the file, or delete {p} "
            f"if it really is the same app.")

def inside(root, p):
    r, q = os.path.realpath(root), os.path.realpath(p)
    return q == r or q.startswith(r + "/")


# ======== 30_host: Host integration: desktop settings read for the sandbox, resource limits, stale-file sweep.

# Desktop settings the sandbox can't read: the title-bar button layout (minimize, maximize, close) and the cursor theme
# and size. ajail runs outside the sandbox, so it reads them on the host and gives the app only these settings, as a
# GSettings key file (GTK reads them from GSettings, and that beats a settings.ini). The app is pointed at it with
# GSETTINGS_BACKEND=keyfile. Nothing is hardcoded: no desktop setting found, nothing is shared.
LAYOUT_KEYS = (("org.gnome.desktop.wm.preferences", "button-layout"),     # GNOME (stored in dconf)
               ("org.cinnamon.muffin", "button-layout"),
               ("org.mate.Marco.general", "button-layout"))
LAYOUT_RE = re.compile(r"[a-z,:_]{0,64}")       # only button names, commas and the colon; anything else is ignored
CURSOR_SCHEMA = "org.gnome.desktop.interface"
CURSOR_THEME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9 ._+-]{0,63}")    # a folder name: no '/', no quotes, no leading dot
CURSOR_SIZE_RE = re.compile(r"[0-9]{1,3}")
CURSOR_SIZE_MAX = 256

def gsettings_get(schema, key):
    """The raw gsettings value as text, or None (no gsettings, no such key, error, timeout)."""
    gs = shutil.which("gsettings")
    if not gs: return None
    try: r = subprocess.run([gs, "get", schema, key], capture_output=True, text=True, timeout=3)
    except Exception: return None
    return r.stdout.strip() if r.returncode == 0 else None

def gsettings_string(raw):
    """The text of a plain gsettings string 'like this', else None. No escapes, no other quote style."""
    if raw is None or len(raw) < 2 or raw[0] != "'" or raw[-1] != "'": return None
    return raw[1:-1]

def gtk_ini_layout():
    """gtk-decoration-layout from your own GTK settings.ini, or None."""
    for ver in ("gtk-4.0", "gtk-3.0"):
        try:
            with open(f"{HOME}/.config/{ver}/settings.ini") as f:
                for ln in f:
                    k, _, v = ln.partition("=")
                    if k.strip() == "gtk-decoration-layout" and LAYOUT_RE.fullmatch(v.strip()): return v.strip()
        except (OSError, UnicodeDecodeError):
            pass
    return None

def host_button_layout():
    """The button layout from the desktop settings (gsettings/dconf), else from your own GTK settings.ini, else None."""
    for schema, key in LAYOUT_KEYS:
        v = gsettings_get(schema, key)
        v = v.strip("'\"") if v is not None else None
        if v is not None and LAYOUT_RE.fullmatch(v): return v
    return gtk_ini_layout()

def host_cursor():
    """(theme, size) of the host's cursor from gsettings; None for whatever is missing or doesn't pass the checks.
    Size 0 means 'default' and counts as unset."""
    theme = gsettings_string(gsettings_get(CURSOR_SCHEMA, "cursor-theme"))
    if theme is not None and not CURSOR_THEME_RE.fullmatch(theme): theme = None
    size = gsettings_get(CURSOR_SCHEMA, "cursor-size")
    if size is not None and CURSOR_SIZE_RE.fullmatch(size) and 0 < int(size) <= CURSOR_SIZE_MAX: size = int(size)
    else: size = None
    return theme, size

def gsettings_keyfile_text():
    """Text of the key file: just the host's button layout and cursor theme/size. None if there is nothing to share.
    Always written under GNOME's schemas, which are the ones GTK reads, whichever desktop the values came from."""
    out = []
    layout = host_button_layout()
    if layout is not None: out.append(f"[org/gnome/desktop/wm/preferences]\nbutton-layout='{layout}'\n")
    theme, size = host_cursor()
    cur = ([f"cursor-theme='{theme}'\n"] if theme is not None else []) + ([f"cursor-size={size}\n"] if size is not None else [])
    if cur: out.append("[org/gnome/desktop/interface]\n" + "".join(cur))
    return "\n".join(out) or None

def make_gsettings_keyfile(d):
    """GSettings key file holding just the host's button layout and cursor, written into the per-run folder D.
    None if there is nothing to share."""
    text = gsettings_keyfile_text()
    if text is None: return None
    os.makedirs(d, mode=0o700, exist_ok=True)
    p = f"{d}/gsettings-keyfile"
    with open(p, "w") as f: f.write(text)
    return p

def limit_props(cfg):
    props = []
    if cfg["mem_max"]: props += ["-p", f"MemoryMax={cfg['mem_max']}M"]
    if cfg["cpu_max"]: props += ["-p", f"CPUQuota={cfg['cpu_max']}%"]
    if cfg["tasks_max"]: props += ["-p", f"TasksMax={cfg['tasks_max']}"]
    return props

def limit_prefix(cfg, name):
    """systemd-run --user --scope wrapper that applies the memory, CPU and process limits. Without systemd the app
    still runs, just without limits (a warning is shown): limits protect your session, they are not a privacy boundary."""
    props = limit_props(cfg)
    if not props: return []
    sr = shutil.which("systemd-run")
    ok = False
    if sr:
        probe = [sr, "--user", "--scope", "--quiet"] + props + ["--", "/usr/bin/true"]
        try: ok = subprocess.run(probe, capture_output=True, timeout=10).returncode == 0
        except Exception: ok = False
    if not ok:
        print("ajail: resource limits are not available here (needs systemd --user with cgroups); running without them",
              file=sys.stderr)
        log("resource limits unavailable", name)
        return []
    return [sr, "--user", "--scope", "--quiet", f"--unit=ajail-{name}-{os.getpid()}"] + props + ["--"]

def sweep_runtime():
    """Remove per-run files and sockets left behind by ajail processes that died."""
    d = f"{runtime_dir()}/ajail"
    try: entries = os.listdir(d)
    except OSError: return
    for e in entries:
        pid = e.split(".", 1)[0]
        if not pid.isdigit() or os.path.exists(f"/proc/{pid}"): continue
        p = f"{d}/{e}"
        if os.path.isdir(p) and not os.path.islink(p): shutil.rmtree(p, ignore_errors=True)
        elif e.endswith(".bus"):
            try: os.unlink(p)
            except OSError: pass


# ======== 40_images: AppImage storage: mounting, moving, trashing, running-state.

def trash_path(p):
    """Move a file or folder to the Trash (needs gio). Returns False if that did not work."""
    return bool(shutil.which("gio")) and subprocess.run(["gio", "trash", p], capture_output=True).returncode == 0

def trash_layer(layer):
    """Move an app's writable /app layer to the Trash. The kernel's overlayfs 'work' dir is scratch space (mode 000
    inside, recreated at the next launch), which gio cannot copy when the Trash is on another mount, so it is removed
    first and only the saved data ('upper') goes to the Trash. Returns False if that did not work."""
    wk = f"{layer}/work"
    for r, ds, fs in os.walk(wk):
        for x in ds + [""]:
            try: os.chmod(os.path.join(r, x) if x else r, 0o700)
            except OSError: pass
    rm_tree(wk)
    for r, ds, fs in os.walk(layer):                 # saved files may be read-only too: make them movable
        for x in ds:
            try: os.chmod(os.path.join(r, x), os.stat(os.path.join(r, x)).st_mode | 0o700)
            except OSError: pass
    return trash_path(layer)

def rm_tree(p):
    if os.path.isdir(p) and not os.path.islink(p): shutil.rmtree(p, ignore_errors=True)

def file_stamp(path):
    st = os.stat(path)
    return f"{st.st_size}:{st.st_mtime_ns}"

# Filesystems where a file is better copied than moved: the original lives on somebody else's disk.
NETFS = ("nfs", "nfs4", "cifs", "smb3", "smbfs", "9p", "afs", "ceph", "glusterfs")

def fs_type(path):
    """Filesystem type of the mount that holds PATH ('' if unknown)."""
    best, typ = "", ""
    try:
        for ln in open("/proc/self/mountinfo"):
            p = ln.split()
            if len(p) < 7 or "-" not in p: continue
            mp = p[4].replace("\\040", " ")
            if (path == mp or path.startswith(mp.rstrip("/") + "/")) and len(mp) >= len(best):
                best, typ = mp, p[p.index("-") + 1]
    except OSError:
        pass
    return typ

def can_move(app):
    """True if an install may take this AppImage out of its folder (like dragging an app into Applications).
    Files on removable drives, network shares and FUSE mounts, and files in folders you can't write to, are copied."""
    if any(app.startswith(b) for b in OUTSIDE): return False
    ft = fs_type(app)
    if ft in NETFS or ft.startswith("fuse."): return False
    return os.access(os.path.dirname(app), os.W_OK | os.X_OK)

def place_image(app, dst, move):
    """Put the AppImage at DST: moved if MOVE is set and it works, otherwise copied. A copy shares disk blocks on
    filesystems that support it (btrfs, XFS), so it costs no extra space there. Returns True if the file was moved."""
    if move:
        try:
            shutil.move(app, dst)
            return True
        except OSError:
            try: os.unlink(dst)           # a half-finished cross-device move leaves a partial file behind
            except OSError: pass
            if not os.path.isfile(app): raise
    r = subprocess.run(["cp", "--reflink=auto", "--", app, dst], capture_output=True)
    if r.returncode:
        shutil.copyfile(app, dst)
    return False

def installed_kind(name):
    d = f"{INSTALLED}/{name}"
    return "root" if os.path.isdir(f"{d}/root") else "mount" if os.path.isfile(f"{d}/image") else None

def need_squashfuse():
    if not (shutil.which("squashfuse") and shutil.which("fusermount3")):
        die("compressed installs need squashfuse: " + install_hint("squashfuse", "fuse3"))
    if not os.access("/dev/fuse", os.R_OK | os.W_OK):
        die("/dev/fuse is not accessible, so compressed installs cannot work on this system")

def sweep_mounts():
    """Unmount and remove mountpoints left behind by ajail processes that died."""
    try: entries = os.listdir(MOUNTS)
    except OSError: return
    for e in entries:
        pid = e.rsplit("-", 1)[-1]
        if pid.isdigit() and os.path.exists(f"/proc/{pid}"): continue
        subprocess.run(["fusermount3", "-uz", f"{MOUNTS}/{e}"], capture_output=True)
        try: os.rmdir(f"{MOUNTS}/{e}")
        except OSError: pass

def mount_image(name):
    d = f"{INSTALLED}/{name}"
    return mount_squashfs(f"{d}/image", open(f"{d}/offset").read().strip(), name)

def mount_squashfs(image, off, name):
    """Mount the squashfs inside an AppImage with squashfuse and return the mountpoint."""
    need_squashfuse()
    sweep_mounts()
    os.makedirs(MOUNTS, mode=0o700, exist_ok=True)
    mp = f"{MOUNTS}/{name}-{os.getpid()}"
    os.makedirs(mp, mode=0o700, exist_ok=True)
    # Show the files as yours (the image's own owner, often root, is not mapped in the sandbox, so the overlay of
    # app_writable would get "Permission denied"). Some squashfuse builds reject uid/gid: then mount as before.
    for opts in (f"offset={off},uid={os.getuid()},gid={os.getgid()}", f"offset={off}"):
        try:
            r = subprocess.run(["squashfuse", "-o", opts, image, mp],
                               capture_output=True, text=True, stdin=subprocess.DEVNULL, timeout=30)
        except subprocess.TimeoutExpired:
            r = subprocess.CompletedProcess([], 1, "", "timed out")
        if not r.returncode: break
    if r.returncode:
        os.rmdir(mp)
        die(f"could not mount the image: {CTRL.sub('', r.stderr).strip() or r.returncode}")
    return mp

def unmount_image(mp):
    if subprocess.run(["fusermount3", "-u", mp], capture_output=True).returncode:
        subprocess.run(["fusermount3", "-uz", mp], capture_output=True)
    try: os.rmdir(mp)
    except OSError: pass

def installed_stamp(name):
    try: return open(f"{INSTALLED}/{name}/stamp").read()
    except OSError: return None

def live_ajail(pid):
    """True if this PID is really an ajail process (a stale pid file may point at a reused PID)."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f: return b"ajail" in f.read()
    except OSError:
        return False

def running(name):
    try:
        return [f for f in os.listdir(RUNNING)
                if f.isdigit() and live_ajail(f) and open(f"{RUNNING}/{f}").read().strip() == name]
    except OSError:
        return []


# ======== 50_run: Launch path: guard, run_app, run_installed, launch. Second-tier review (it handles the app's output streams).

def guard():
    if os.geteuid() == 0: die("refusing to run apps as root")
    if os.environ.get("AJAIL_ACTIVE"): die("recursion detected, aborting. Run: ajail off")
    if not shutil.which("bwrap"): die("bubblewrap missing: " + install_hint("bubblewrap"))

def check_display(cfg):
    if not cfg["x11"] and not wayland_path():
        die("no Wayland session found. Enable 'X11 compatibility' for this app in ajail-gui.")

def run_app(arg, extra, once=False, mount=False, compat=False):
    guard()
    app = os.path.realpath(arg)
    if not os.path.isfile(app): die(f"not a file: {arg}")
    off = appimage_offset(app)
    name = sanitize(app)
    cfg = load_cfg(name)
    if compat: cfg["compat_env"] = 1
    check_display(cfg)
    if mount:
        # Nothing is unpacked: the AppImage itself is mounted for this run (squashfuse, outside the sandbox).
        mp = mount_squashfs(app, off, name)
        try:
            launch(name, mp, cfg, extra, source=app)
        finally:
            unmount_image(mp)
        return
    launch(name, ensure_extracted(app, name, off), cfg, extra, source=app, once=once)

def run_installed(name, extra, compat=False):
    guard()
    name = clean(name)
    kind = installed_kind(name)
    if not kind: die(f"'{name}' is not installed")
    cfg = load_cfg(name)
    if compat: cfg["compat_env"] = 1
    check_display(cfg)
    if kind == "root":
        launch(name, f"{INSTALLED}/{name}/root", cfg, extra)
        return
    mp = mount_image(name)
    try:
        launch(name, mp, cfg, extra)
    finally:
        unmount_image(mp)

def launch(name, root, cfg, extra, source=None, once=False):
    if not os.path.lexists(f"{root}/AppRun"): die("no AppRun found inside this AppImage")
    check_identity(name, root)
    os.makedirs(HOMES, mode=0o700, exist_ok=True)
    os.makedirs(f"{HOMES}/{name}", mode=0o700, exist_ok=True); os.chmod(f"{HOMES}/{name}", 0o700)
    os.makedirs(RUNNING, exist_ok=True); os.makedirs(SOURCES, exist_ok=True)
    if source:
        try: open(f"{SOURCES}/{name}", "w").write(source)
        except OSError: pass
    if cfg["net_private"] and not cfg["net"]:
        warn("'Keep localhost private' does nothing while the network is off; the app has no network at all", name)
    priv = private_net(cfg)
    if priv and not shutil.which("pasta"):
        die("'Keep localhost private' needs pasta: " + install_hint("passt") + ". Or turn that option off for this app.")
    sweep_runtime()
    bus = start_bus(cfg, name)
    sec = seccomp_file(cfg["harden"])
    if sec is None and platform.machine() not in ("x86_64", "aarch64"):
        warn(f"no system-call filter for the {platform.machine()} architecture; running without it", name)
    elif sec is None:                             # a filter exists for this CPU but could not be made: never run without it silently
        stop_bus(bus)
        die("could not create the system-call filter (see the log); not starting the app without it")
    secpath, gset = None, None
    wd = work_dir(); gen = make_files(cfg, wd, name)
    if cfg["theme"]: gset = make_gsettings_keyfile(wd)
    if priv and sec:
        secpath = f"{wd}/seccomp.bpf"
        sec.seek(0)
        with open(secpath, "wb") as f: f.write(sec.read())
    secfd = (SEC_FD if secpath else None) if priv else (sec.fileno() if sec else None)
    inner = bwrap_args(name, root, cfg, ["/app/AppRun"] + extra, bus[2] if bus else None,
                       secfd, forward_files(extra), gen, gset)
    cmd = limit_prefix(cfg, name) + (net_wrap(inner, secpath) if priv else inner)
    on = ",".join(k for k in DEFAULTS if cfg[k])
    lim = ",".join(f"{k}={cfg[k]}" for k in NUM if cfg[k])
    log(f"START allow=[{on}] limits=[{lim}] seccomp={'on' if sec else 'off'} dbus={'on' if bus else 'off'}", name)
    start = time.time()
    tty = sys.stdout.isatty()                     # to a terminal, stdout is filtered too; to a pipe or file it stays untouched
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE if tty else None, stderr=subprocess.PIPE, text=True, errors="replace",
                         pass_fds=[sec.fileno()] if sec and not priv else ())
    pidfile = f"{RUNNING}/{os.getpid()}"
    open(pidfile, "w").write(name)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, lambda *_: p.terminate())
    def tee():
        try:
            with open(LOG, "a") as lf:
                n = 0                             # a chatty app must not fill the disk: cap what one run adds to the log
                dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
                pend = ""                         # the unfinished line, kept short: a flood without newlines must not fill memory
                while True:
                    data = os.read(p.stderr.fileno(), 4096)
                    text = CTRL.sub("", dec.decode(data, final=not data))     # an app must not inject terminal escape sequences (OSC 52 etc.)
                    try: sys.stderr.write(text); sys.stderr.flush()
                    except Exception: pass
                    lines = (pend + text).split("\n"); pend = lines.pop()
                    lines = [x + "\n" for x in lines]
                    while len(pend) > LOG_LINE_MAX: lines.append(pend[:LOG_LINE_MAX] + "\n"); pend = pend[LOG_LINE_MAX:]
                    if not data and pend: lines.append(pend + "\n"); pend = ""
                    for line in lines:
                        if n < LOG_RUN_MAX:
                            n += len(line)
                            lf.write(f"[{name}] {line}")
                            if n >= LOG_RUN_MAX: lf.write(f"[{name}] (more output not logged)\n")
                            lf.flush()
                    if not data: break
        except Exception:
            pass
    def pump():                                   # chunks, not lines, so a prompt without a newline shows at once
        try:
            dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
            while True:
                data = os.read(p.stdout.fileno(), 4096)
                text = dec.decode(data, final=not data)
                try: sys.stdout.write(CTRL.sub("", text)); sys.stdout.flush()
                except Exception: pass
                if not data: break
        except Exception:
            pass
    t = threading.Thread(target=tee, daemon=True); t.start()
    t2 = threading.Thread(target=pump, daemon=True) if tty else None
    if t2: t2.start()
    rc = p.wait(); t.join(2)
    if t2: t2.join(2)
    stop_bus(bus)
    if wd: shutil.rmtree(wd, ignore_errors=True)
    try: os.unlink(pidfile)
    except OSError: pass
    if once and not running(name): rm_tree(f"{EXTRACT}/{name}")
    log(f"EXIT code={rc}", name)
    if rc != 0 and time.time() - start < 10:
        notify_failure(name)
    sys.exit(rc)


# ======== 60_desktop: Desktop entries and icons for installed apps.

DESKTOP_LINE_MAX = 1000     # longer lines of an app's .desktop file are not copied into its launcher
DESKTOP_KEEP = re.compile(r"(Name|GenericName|Comment|Keywords)(\[[A-Za-z0-9_@.-]+\])?=|(Categories|MimeType|StartupWMClass)=")

def read_desktop(root):
    """Name, categories and the like from the app's own .desktop file. Exec and similar keys are never copied."""
    keep, icon = [], None
    for f in sorted(glob.glob(f"{glob.escape(root)}/*.desktop"))[:1]:
        if not inside(root, f): continue
        if not os.path.isfile(f): continue          # no FIFOs or devices
        try:
            with open(f, errors="replace") as fh: text = fh.read(65536)
        except OSError: continue
        for ln in text.splitlines():
            ln = ln.strip()
            if ln.startswith("["):
                if ln != "[Desktop Entry]": break
                continue
            if CTRL.search(ln) or len(ln) > DESKTOP_LINE_MAX: continue     # control characters (incl. DEL and C1) and huge lines
            if ln.startswith("Icon="): icon = ln[5:]
            elif DESKTOP_KEEP.match(ln): keep.append(ln)
    return keep, icon

ICON_SIZES = (16, 22, 24, 32, 36, 48, 64, 72, 96, 128, 192, 256, 512)      # the size folders the hicolor theme lists
SVG_HEAD = 16384        # an SVG may start with a long XML prolog, comments or a doctype before <svg

def icon_size_dir(w):
    """The hicolor folder for a PNG w pixels wide. The theme only looks in the sizes it lists, so a 100, 300 or 1024 pixel icon put
    in a folder of its own size is never found and the menu shows a generic icon. It goes in the nearest listed size instead."""
    return "%dx%d" % ((s := min(ICON_SIZES, key=lambda x: (abs(x - w), -x))), s)

def find_icon(root, icon):
    """Best icon inside the extracted app as (path, extension, size dir), or None."""
    r = glob.escape(root)
    cands = [f"{root}/.DirIcon"]
    if icon and re.fullmatch(r"[A-Za-z0-9._+-]+", icon):
        for ext in ("svg", "png"):
            cands += (glob.glob(f"{r}/usr/share/icons/hicolor/*/apps/{icon}.{ext}") + [f"{root}/{icon}.{ext}"]
                      + glob.glob(f"{r}/usr/share/icons/*/*/apps/{icon}.{ext}") + glob.glob(f"{r}/usr/share/icons/{icon}.{ext}")
                      + glob.glob(f"{r}/usr/share/pixmaps/{icon}.{ext}"))     # fixed depths, so no link loop can run away
    best = None
    for p in cands:
        try:
            if not os.path.isfile(p) or not inside(root, p) or os.path.getsize(p) > 5_000_000: continue
            with open(p, "rb") as fh: head = fh.read(SVG_HEAD)
        except OSError:
            continue
        if b"<svg" in head.lower(): cand = ((1, 0), p, "svg", "scalable")
        elif head[:8] == b"\x89PNG\r\n\x1a\n" and len(head) >= 24:
            w, h = struct.unpack(">II", head[16:24])
            if not 16 <= max(w, h) <= 8192: continue
            cand = ((0, max(w, h)), p, "png", icon_size_dir(max(w, h)))
        else: continue
        if best is None or cand[0] > best[0]: best = cand
    return best[1:] if best else None

def remove_icons(name):
    for p in glob.glob(f"{ICONS}/*/apps/ajail-{name}.*"):
        try: os.unlink(p)
        except OSError: pass

def refresh_icon_cache():
    """Make the menu notice a new icon. The icon theme trusts an old icon-theme.cache unless the theme's top folder is newer, and adding
    a file inside an existing size folder does not change that folder's time, so the new icon stays unseen until it is touched."""
    try: os.utime(ICONS)
    except OSError: return
    tool = shutil.which("gtk-update-icon-cache") or shutil.which("gtk4-update-icon-cache")
    if tool and os.path.exists(f"{ICONS}/icon-theme.cache"):
        subprocess.run([tool, "-f", "-t", ICONS], capture_output=True, check=False)

def refresh_desktop_db():
    if shutil.which("update-desktop-database"):
        subprocess.run(["update-desktop-database", APPLICATIONS], capture_output=True, check=False)

def install_launcher(name, root):
    keep, icon = read_desktop(root)
    remove_icons(name)
    found, iname = find_icon(root, icon), None
    if found:
        src, ext, size = found
        os.makedirs(f"{ICONS}/{size}/apps", exist_ok=True)
        shutil.copyfile(src, f"{ICONS}/{size}/apps/ajail-{name}.{ext}")
        iname = f"ajail-{name}"
        refresh_icon_cache()
        print(f"icon: {src.replace(root + '/', '', 1)} -> {ICONS}/{size}/apps/{iname}.{ext}")
    else: print("icon: none found in this app, so the menu shows a generic one")
    lines = ["[Desktop Entry]", "Type=Application", f"Exec={SELF} run {name} %U", "Terminal=false", f"X-AJAIL-App={name}"]
    if not any(k.startswith("Name=") for k in keep): lines.append(f"Name={name}")
    lines += keep
    if iname: lines.append(f"Icon={iname}")
    os.makedirs(APPLICATIONS, exist_ok=True)
    path = f"{APPLICATIONS}/ajail-{name}.desktop"
    open(path + ".tmp", "w").write("\n".join(lines) + "\n")
    os.replace(path + ".tmp", path)
    refresh_desktop_db()


# ======== 70_commands: Command-line commands and entry point.

def cmd_install(args):
    usage = "usage: ajail install FILE.AppImage [--mount [--move]] [--trash]"
    opts, files = split_opts(args, ("--trash", "--mount", "--move"), usage)
    trash, mount, move = "--trash" in opts, "--mount" in opts, "--move" in opts
    if len(files) != 1: die(usage)
    if move and not mount: die("--move only works together with --mount")
    if move and trash: die("use either --move or --trash, not both")
    guard()
    if mount: need_squashfuse()
    app = os.path.realpath(files[0])
    if not os.path.isfile(app): die(f"not a file: {files[0]}")
    off = appimage_offset(app)
    name = sanitize(app)
    dest = f"{INSTALLED}/{name}"
    kind = "mount" if mount else "root"
    moved = False
    # A compressed install keeps the AppImage itself. By default it is copied (the original stays). With --move it is
    # moved into ajail's folder instead (no duplicate). Symlinks, removable or network drives and read-only folders are
    # always copied, even with --move.
    movable = move and can_move(app) and not os.path.islink(files[0])
    if installed_stamp(name) == file_stamp(app) and installed_kind(name) == kind:
        print(f"{name} is already installed" + ("" if mount else ", refreshing its launcher"))
        if not mount: install_launcher(name, f"{dest}/root")
    else:
        if running(name): die(f"{name} is running. Close it first")
        root = ensure_extracted(app, name, off)
        if not os.path.lexists(f"{root}/AppRun"): die("no AppRun found inside this AppImage")
        check_identity(name, root)
        os.makedirs(INSTALLED, mode=0o700, exist_ok=True)
        rm_tree(dest)
        if mount:
            os.makedirs(dest, mode=0o700)
            stamp = file_stamp(app)                    # taken first: after a move the original is gone
            try:
                moved = place_image(app, f"{dest}/image", movable)
            except OSError as e:
                rm_tree(dest)
                die(f"could not store the AppImage: {e.strerror or e}")
            open(f"{dest}/offset", "w").write(str(off))
            open(f"{dest}/stamp", "w").write(stamp)
            if moved: open(f"{dest}/origin", "w").write(app)     # lets 'ajail restore' put it back
            install_launcher(name, root)
            rm_tree(f"{EXTRACT}/{name}")
        else:
            os.replace(f"{EXTRACT}/{name}", dest)
            install_launcher(name, f"{dest}/root")
    os.makedirs(f"{CONF}/apps", exist_ok=True)
    open(f"{CONF}/apps/{name}.conf", "a").close()
    try:                                              # where the file came from, so ajail-gui can offer to trash it
        os.makedirs(SOURCES, exist_ok=True)
        open(f"{SOURCES}/{name}", "w").write(app)
    except OSError:
        pass
    log("installed (compressed" + (", moved)" if moved else ")") if mount else "installed", name)
    print(f"Installed {name}" + (" (compressed, mounted at launch)" if mount else ""))
    if mount and moved: print("Moved the AppImage into ajail")
    elif mount and move: print("ajail: copied the AppImage instead of moving it (removable or network drive, symlink, "
                               "or a folder you can't write to); the original was kept", file=sys.stderr)
    if trash:
        if shutil.which("gio") and subprocess.run(["gio", "trash", app]).returncode == 0:
            print("Moved the AppImage to the Trash")
        else:
            print("ajail: could not move the AppImage to the Trash", file=sys.stderr)

def cmd_uninstall(args):
    usage = "usage: ajail uninstall NAME [--purge] [--discard-image]"
    opts, names = split_opts(args, ("--purge", "--discard-image"), usage)
    purge, discard = "--purge" in opts, "--discard-image" in opts
    if len(names) != 1: die(usage)
    name = clean(names[0])
    if running(name): die(f"{name} is running. Close it first")
    d = f"{INSTALLED}/{name}"
    if os.path.exists(f"{d}/origin") and os.path.isfile(f"{d}/image") and not discard:
        die(f"{name}'s AppImage was moved into ajail and uninstalling would delete it. Run 'ajail restore {name}' to put "
            f"it back (this also uninstalls), 'ajail restore {name} --to FOLDER' to put it in another folder, or add "
            f"--discard-image to delete it")
    rm_tree(f"{INSTALLED}/{name}")
    try: os.unlink(f"{APPLICATIONS}/ajail-{name}.desktop")
    except OSError: pass
    remove_icons(name)
    moved = layer_failed = False
    if purge:
        home = f"{HOMES}/{name}"
        if not os.path.lexists(home): moved = True
        elif os.path.isdir(home) and not os.path.islink(home):
            moved = trash_path(home)      # the data goes to the Trash, never deleted outright
            if not moved: print(f"ajail: could not move {home} to the Trash, so its data was kept", file=sys.stderr)
        if moved:                          # settings go with the data; if the data stayed, so do they
            rm_tree(f"{EXTRACT}/{name}"); forget_app_ui(name)
            for p in (f"{CONF}/apps/{name}.conf", f"{CONF}/ids/{name}", f"{SOURCES}/{name}"):
                try: os.unlink(p)
                except OSError: pass
    if purge:      # the writable layer (e.g. game saves) goes to the Trash too, like the private home
        layer = f"{LAYERS}/{name}"
        if os.path.islink(layer): os.unlink(layer)
        elif os.path.isdir(layer) and not trash_layer(layer):
            layer_failed = True
            print(f"ajail: could not move {layer} to the Trash, so it was kept", file=sys.stderr)
    refresh_desktop_db()
    log("uninstalled" + (" and purged" if moved else ""), name)
    print(f"Uninstalled {name}" + (" and moved its data to the Trash" if moved else ", its data was kept"))
    if layer_failed: sys.exit(1)       # the app is uninstalled, but say so loudly: its writable layer is still on disk

def cmd_restore(args):
    """Undo a compressed install that moved the AppImage: put the file back where it came from and uninstall the app
    (its data and settings are kept)."""
    keep, dest = "--keep" in args, None
    if "--to" in args:
        i = args.index("--to")
        if i + 1 >= len(args): die("--to needs a folder")
        dest = args[i + 1]; del args[i:i + 2]
    args = [x for x in args if x != "--keep"]
    if len(args) != 1: die("usage: ajail restore NAME [--keep] [--to FOLDER]")
    name = clean(args[0])
    if running(name) and not keep: die(f"{name} is running. Close it first")
    d = f"{INSTALLED}/{name}"
    try: origin = open(f"{d}/origin").read().strip()
    except OSError: die(f"{name} was not moved into ajail, so there is nothing to put back")
    img = f"{d}/image"
    if not os.path.isfile(img): die(f"{name} has no stored AppImage")
    target = os.path.join(os.path.realpath(dest), os.path.basename(origin)) if dest else origin     # --to: another folder
    if not os.path.isabs(target) or not os.path.isdir(os.path.dirname(target)):
        die("the folder " + ("does not exist" if dest else "it came from no longer exists") + f": {os.path.dirname(target)}"
            + ("" if dest else f". Use 'ajail restore {name} --to FOLDER' to pick another one"))
    if os.path.lexists(target): die(f"{target} already exists, so the AppImage was not put back")
    if keep:
        # Put a copy back and leave the app installed (it still needs its stored image). Nothing is left to protect, so
        # the marker goes and a later uninstall no longer refuses.
        try:
            place_image(img, target, False)
            os.chmod(target, os.stat(img).st_mode & 0o777)
            os.unlink(f"{d}/origin")
        except OSError as e: die(f"could not put the AppImage back: {e.strerror or e}")
        print(f"Put a copy of the AppImage back at {target}; {name} stays installed")
        return
    try: shutil.move(img, target)
    except OSError as e: die(f"could not put the AppImage back: {e.strerror or e}")
    print(f"Put the AppImage back at {target}")
    try: os.unlink(f"{d}/origin")             # the file is back: uninstalling no longer needs to protect it
    except OSError: pass
    cmd_uninstall([name])

def ui_get(key):
    try:
        for ln in open(f"{CONF}/ui.conf"):
            k, _, v = ln.strip().partition("=")
            if k == key: return v
    except OSError:
        pass
    return None

def open_mode(name=None):
    """'ask' or 'run' for double-clicking an AppImage: the app's own setting (open_mode.NAME), else the global one."""
    for key in ((f"open_mode.{name}",) if name else ()) + ("open_mode",):
        v = ui_get(key)
        if v in ("ask", "run"): return v
    return "ask"

def forget_app_ui(name):
    """Drop an app's remembered open/mount choices from ui.conf."""
    try:
        lines = open(f"{CONF}/ui.conf").read().splitlines()
        keep = [l for l in lines if l.partition("=")[0] not in (f"open_mode.{name}", f"mount.{name}")]
        if keep != lines: open(f"{CONF}/ui.conf", "w").write("".join(l + "\n" for l in keep))
    except OSError:
        pass

def open_file(arg, extra):
    """Entry point for double-click and 'Open with': offer Install or Run once, unless launched from a terminal."""
    gui = f"{os.path.dirname(SELF)}/ajail-gui"
    app = os.path.realpath(arg) if os.path.isfile(arg) else None
    name = sanitize(app) if app else None
    from_desktop = not (sys.stdin.isatty() or sys.stdout.isatty()) and bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY"))
    if (app and open_mode(name) == "ask" and not extra and os.path.exists(gui) and from_desktop
            and not (os.environ.get("AJAIL_ACTIVE") or os.geteuid() == 0)):
        if installed_stamp(name) == file_stamp(app): return run_installed(name, extra)
        p = subprocess.Popen([gui, "--install", app], start_new_session=True)
        try:
            if p.wait(2) != 0: run_app(arg, extra)
        except subprocess.TimeoutExpired:
            pass
        return
    # No prompt for this app. From the desktop: use its installed copy if it is the same file, otherwise run the file
    # unpacked in the sandbox. "Use less disk space" only applies to installs. Terminal launches never prompt.
    if app and from_desktop:
        if installed_stamp(name) == file_stamp(app): return run_installed(name, extra)
    run_app(arg, extra)

def need_root(cmd):
    if os.geteuid() != 0:
        os.execvp("pkexec", ["pkexec", SELF, cmd])

def cmd_on():
    need_root("on")
    if not os.path.exists(SELF) or os.stat(SELF).st_uid != 0: die(f"{SELF} must exist and be owned by root")
    for t in ("bwrap", "unsquashfs"):
        if not shutil.which(t): die(f"{t} missing: " + install_hint("bubblewrap", "squashfs-tools"))
    open("/etc/binfmt.d/appimage-jail.conf", "w").write(RULE + "\n")
    subprocess.run(["systemctl", "restart", "systemd-binfmt"], check=True)
    print("ON: AppImages now run sandboxed")

def cmd_off():
    need_root("off")
    try: open(f"{BM}/appimage-jail", "w").write("-1")
    except OSError: pass
    try: os.unlink("/etc/binfmt.d/appimage-jail.conf")
    except OSError: pass
    print("OFF")

def cmd_check():
    def line(k, m): print(f"{k:5} {m}")
    def yes(c, ok, no, lvl="INFO"): line("OK" if c else lvl, ok if c else no)
    yes(shutil.which("bwrap"), "bubblewrap installed", "bubblewrap missing", "WARN")
    yes(os.path.exists(UNSQ), "squashfs-tools installed", "squashfs-tools missing", "WARN")
    r = subprocess.run(["bwrap"] + BASE + ["--unshare-all", "/usr/bin/true"], capture_output=True)
    line("OK" if r.returncode == 0 else "WARN", "unprivileged sandboxes work" if r.returncode == 0
         else "bwrap test failed: " + r.stderr.decode(errors="replace").strip()[:150])
    yes(wayland_path(), "Wayland socket found", "no Wayland socket visible to this process")
    yes(os.path.exists("/dev/dri"), "GPU devices (/dev/dri) present", "no /dev/dri")
    if glob.glob("/dev/nvidia*"): line("OK", "NVIDIA devices will be shared when Graphics is on")
    yes(shutil.which("xdg-dbus-proxy"), "xdg-dbus-proxy installed (notifications, portals, tray)",
        "xdg-dbus-proxy missing: " + install_hint("xdg-dbus-proxy"))
    yes(seccomp_file(), "seccomp filter available", "seccomp filter not available on this CPU architecture")
    yes(bwrap_has("--disable-userns"), "bubblewrap supports disabling nested sandboxes",
        "bubblewrap too old for 'Allow the app's own sandbox = off'")
    yes(bwrap_has("--hostname"), "bubblewrap can hide the computer name", "bubblewrap too old for 'Hide personal details' to hide the computer name")
    yes(shutil.which("pasta"), "pasta installed ('Keep localhost private' available)",
        "pasta missing, so 'Keep localhost private' cannot be used: " + install_hint("passt"))
    sr = shutil.which("systemd-run")
    lim = bool(sr) and subprocess.run([sr, "--user", "--scope", "--quiet", "-p", "TasksMax=infinity", "--", "/usr/bin/true"],
                                      capture_output=True).returncode == 0
    yes(lim, "resource limits available (systemd --user)", "resource limits unavailable: needs systemd --user with cgroups")
    on = os.path.exists(f"{BM}/appimage-jail")
    line("OK" if on else "INFO", "forcing is ON" if on else "forcing is OFF")
    try:
        for n in os.listdir(BM):
            if n in ("register", "status", "appimage-jail"): continue
            if "4149" in open(f"{BM}/{n}").read().lower():
                line("WARN", f"another AppImage handler is registered: {n} (may conflict)")
    except OSError:
        pass
    if not shutil.which("notify-send"): line("INFO", "notify-send missing (no failure popups)")
    ok = shutil.which("squashfuse") and shutil.which("fusermount3") and os.access("/dev/fuse", os.R_OK | os.W_OK)
    line("OK" if ok else "INFO", "compressed installs (experimental) available" if ok
         else "compressed installs unavailable: needs squashfuse, fuse3 and access to /dev/fuse")

def cmd_preview(n):
    NO_LOG[0] = True
    name = clean(n) if n else "NAME"
    cfg = load_cfg(name)
    bus = f"{runtime_dir()}/ajail/PID.bus" if want_bus(cfg) else None
    root = f"{INSTALLED}/{name}/root"
    if installed_kind(name) == "mount": root = f"{MOUNTS}/{name}"
    elif not os.path.isdir(root): root = f"{EXTRACT}/{name}/root"
    priv = private_net(cfg)
    gset = f"{runtime_dir()}/ajail/PID.d/gsettings-keyfile" if cfg["theme"] and gsettings_keyfile_text() is not None else None
    cmd = bwrap_args(name, root, cfg, ["/app/AppRun"], bus, SEC_FD if priv else None, (), preview_files(cfg), gset)
    if priv: cmd = net_wrap(cmd, f"{runtime_dir()}/ajail/PID.d/seccomp.bpf")
    props = limit_props(cfg)
    if props: cmd = ["systemd-run", "--user", "--scope", "--quiet"] + props + ["--"] + cmd
    print(shlex.join(cmd))

def app_list():
    """Every app ajail knows about: installed, with a settings file, or with saved data."""
    names = set()
    for d, ext in ((f"{CONF}/apps", ".conf"), (HOMES, ""), (INSTALLED, "")):
        try: entries = os.listdir(d)
        except OSError: continue
        for f in entries:
            if ext and not f.endswith(ext): continue      # e.g. NAME.machine-id belongs to an app but is not an app
            n = f[:-len(ext)] if ext else f
            if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", n): names.add(n)
    return sorted(names)

def cmd_list():
    for n in app_list():
        state = "running" if running(n) else "installed" if installed_kind(n) else "data only"
        print(f"{n:32} {state}")

def cmd_stop(args):
    if len(args) != 1: die("usage: ajail stop NAME")
    name = clean(args[0])
    pids = running(name)
    if not pids: die(f"{name} is not running")
    for pid in pids:
        try: os.kill(int(pid), signal.SIGTERM)
        except OSError: pass
    print(f"Stopping {name}")

def cmd_dump(arg):
    """JSON of the raw settings, for ajail-gui."""
    NO_LOG[0] = True          # the GUI calls this on every refresh; warnings must not flood the log
    g = parse_cfg(f"{CONF}/default.conf") or empty_cfg()
    if arg == "--all":
        apps = {}
        try:
            for f in os.listdir(f"{CONF}/apps"):
                if f.endswith(".conf"): apps[f[:-5]] = parse_cfg(f"{CONF}/apps/{f}") or empty_cfg()
        except OSError:
            pass
        out = {"global": g, "apps": apps}
    else:
        out = {"global": g, "app": (parse_cfg(f"{CONF}/apps/{clean(arg)}.conf") or empty_cfg()) if arg else None}
    print(json.dumps(out))

HELP = """ajail on | off | status | check   force on/off for all AppImages, or check the setup
ajail preview [NAME]             show the bwrap command that would run
ajail list                       show your apps and which ones are running
ajail stop NAME                  stop a running app
ajail name FILE.AppImage         show the name ajail uses for this file
ajail install FILE.AppImage      unpack it and add it to the app menu; the file is left where it is (--trash moves it to
                                 the Trash; --mount keeps it compressed and mounts it at launch, experimental; with
                                 --mount, --move moves the file into ajail's folder instead of copying it, and falls
                                 back to a copy on a removable or network drive)
ajail run [--compat-env] NAME [args]
                                 run an installed app (--compat-env passes a short list of graphics and toolkit
                                 variables from your session into the sandbox for this run; the permission
                                 compat_env=1 does it every time)
ajail uninstall NAME [--purge]   remove it from the app menu (--purge also moves its data to the Trash); refuses to
                                 delete an AppImage that was moved into ajail (use restore, or --discard-image)
ajail restore NAME [--keep] [--to FOLDER]
                                 undo a compressed install that moved the file: put it back and uninstall
                                 (--keep puts a copy back and leaves the app installed; --to picks the folder)
ajail run-file [--once] [--mount] [--compat-env] FILE
                                 run an AppImage without offering to install it (--once deletes its unpacked copy on exit;
                                 --mount mounts the file instead of unpacking it, experimental; ignored with --once)
ajail FILE.AppImage [args]       open an AppImage: offers Install or Run once when double-clicked,
                                 otherwise runs it sandboxed (files in args are shared for that run)
Settings and everything else: ajail-gui"""

def main():
    a = sys.argv[1:]
    c = a[0] if a else "help"
    if c in ("help", "-h", "--help"): print(HELP)
    elif c == "on": cmd_on()
    elif c == "off": cmd_off()
    elif c == "status": print("Forcing: ON" if os.path.exists(f"{BM}/appimage-jail") else "Forcing: OFF")
    elif c == "check": cmd_check()
    elif c == "preview": cmd_preview(a[1] if len(a) > 1 else "")
    elif c == "dump": cmd_dump(a[1] if len(a) > 1 else "")
    elif c == "list" and len(a) == 1: cmd_list()
    elif c == "stop": cmd_stop(a[1:])
    elif c == "name" and len(a) > 1: print(sanitize(a[1]))
    elif c == "install": cmd_install(a[1:])
    elif c == "uninstall": cmd_uninstall(a[1:])
    elif c == "restore": cmd_restore(a[1:])
    elif c == "run" and len(a) > 1 and a[1] == "--compat-env" and len(a) > 2: run_installed(a[2], a[3:], True)
    elif c == "run" and len(a) > 1: run_installed(a[1], a[2:])
    elif c == "run-file":
        rest, flags = a[1:], set()
        while rest and rest[0] in ("--once", "--mount", "--compat-env"):
            flags.add(rest.pop(0))
        if not rest: die("usage: ajail run-file [--once] [--mount] [--compat-env] FILE [args]")
        run_app(rest[0], rest[1:], "--once" in flags, "--mount" in flags and "--once" not in flags, "--compat-env" in flags)   # once never mounts
    else: open_file(c, a[1:])

main()
