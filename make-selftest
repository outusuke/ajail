row(yn(os.path.exists(f"{rt}/pipewire-0") or os.path.exists(f"{rt}/pulse/native")), "Audio sockets")
row(yn(bool(os.environ.get("WAYLAND_DISPLAY")) and os.path.exists(f"{rt}/{os.environ.get('WAYLAND_DISPLAY','')}")), "Wayland socket")
row(yn(bool(os.environ.get("DISPLAY"))), "X11", os.environ.get("DISPLAY", ""))

def xauth_entries(path):
    """Entries of an Xauthority file as (family, address, display number, auth name, auth data)."""
    try: d = open(path, "rb").read()
    except OSError: return None
    ents, i = [], 0
    while i < len(d):
        fam = int.from_bytes(d[i:i+2], "big"); i += 2
        parts = []
        for _ in range(4):
            n = int.from_bytes(d[i:i+2], "big"); i += 2
            parts.append(d[i:i+n]); i += n
        ents.append((fam, *parts))
    return ents

# Only meaningful with "X11 compatibility" on (DISPLAY is not set otherwise). ajail should share just this
# display's cookie, not every cookie in your XAUTHORITY file, and the app must still be able to log in.
xd = os.environ.get("DISPLAY", "")
