# make-selftest - builds ajail-selftest.AppImage, a tiny AppImage that reports what the sandbox allows.
# It only runs through ajail (it has no real AppImage runtime):   ajail ./ajail-selftest.AppImage
# Needs: mksquashfs (package squashfs-tools).
import os, shutil, struct, subprocess, sys, tempfile

APPRUN = r'''#!/usr/bin/python3
